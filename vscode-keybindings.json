// Place your key bindings in this file to override the defaults
[
    { "key": "ctrl+j", "command": "workbench.action.terminal.focus" },
    { "key": "ctrl+j", "command": "workbench.action.focusActiveEditorGroup", "when": "terminalFocus" },
    {
        "key": "ctrl+shift+j",
        "command": "workbench.action.toggleMaximizedPanel"
    },
    { 
        "key": "enter", "command": "acceptSelectedSuggestion",
        "when": "suggestWidgetHasFocusedSuggestion && suggestWidgetVisible && textInputFocus"
    },
    { 
        "key": "tab", "command": "selectNextSuggestion",
        "when": "suggestWidgetHasFocusedSuggestion && suggestWidgetVisible && textInputFocus"
    },
    { 
        "key": "shift+tab", "command": "selectPrevSuggestion",
        "when": "suggestWidgetHasFocusedSuggestion && suggestWidgetVisible && textInputFocus"
    },
]